# ── HomePro Backend — Environment Variables ──────────────────────────────────
# Copy this file to .env for local dev, or set these in Render's dashboard for production.

APP_NAME=Home Pro Manager

# Set to False in production
DEBUG=False

# Frontend URL — must match exactly (no trailing slash)
# Local:      http://localhost:3000
# Production: https://homepro.gichiniwaruingi.com
FRONTEND_URL=https://homepro.gichiniwaruingi.com

# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# Use a DIFFERENT key for production than local dev. Never reuse or commit.
JWT_SECRET_KEY=your-128-char-hex-secret-here

# Supabase transaction pooler URL (port 6543)
# Format: postgresql+asyncpg://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Set to False after all household accounts are created
ALLOW_REGISTRATION=False
