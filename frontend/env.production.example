# ── HomePro Frontend — Production Environment Variables ──────────────────────
# Set these in Vercel's dashboard under Project → Settings → Environment Variables.
# Select "Production" environment only.

# The Render backend URL (use custom subdomain once DNS is set up)
# Option A — Render default (use this first):  https://homepro-api.onrender.com
# Option B — Custom subdomain (after DNS):     https://api.homepro.gichiniwaruingi.com
NEXT_PUBLIC_API_URL=https://api.homepro.gichiniwaruingi.com
